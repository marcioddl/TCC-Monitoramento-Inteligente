# Copie para .env e ajuste. O .env NAO e versionado.

DATABASE_URL=postgresql+psycopg://miiu:miiu_dev@localhost:5432/miiu

# Senha unica do painel de gestao (decisao 2.1 do plano)
ADMIN_SENHA=troque_esta_senha

# Diretorio de imagens enviadas
UPLOAD_DIR=uploads

# Limite de upload em megabytes
UPLOAD_MAX_MB=10

# Raio padrao das geocercas, em metros
GEOFENCE_RAIO_PADRAO=100

# Limiar de confianca abaixo do qual a ocorrencia vai para triagem humana
INFERENCIA_LIMIAR=0.50
