# Copie para .env e ajuste. O .env NAO e versionado.
# Todas as opcoes abaixo, exceto DATABASE_URL, tem valor padrao.

DATABASE_URL=postgresql+psycopg://miiu:miiu_dev@localhost:5432/miiu

# Senha unica do painel de gestao (decisao 2.1 do plano)
ADMIN_SENHA=troque_esta_senha
# Validade do login no painel, em horas
TOKEN_VALIDADE_HORAS=12

# Diretorio de imagens enviadas
UPLOAD_DIR=uploads

# Limite de upload em megabytes
UPLOAD_MAX_MB=10

# Raio padrao das geocercas, em metros
GEOFENCE_RAIO_PADRAO=100
# Leituras de GPS com incerteza acima disto (m) nao disparam alertas
GEOFENCE_PRECISAO_MAX_M=150

# Limiar de confianca abaixo do qual a ocorrencia vai para triagem humana
INFERENCIA_LIMIAR=0.50

# Pesos do YOLOv8 treinado (gerado por ml/scripts/treinar.py).
# Se o arquivo nao existir, a API funciona e tudo vai para triagem humana.
MODELO_PATH=modelos/miiu_yolov8.pt

# JSON da conta de servico do Firebase (Console > Configuracoes do projeto >
# Contas de servico > Gerar nova chave privada). Vazio = modo simulado.
FIREBASE_CREDENCIAIS=

# Reportes permitidos por aparelho por hora
LIMITE_REPORTES_HORA=10

# Origens do painel em modo de desenvolvimento (npm run dev)
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
